{
  "description": "minCardCount avec une famille réussit quand la section a assez de cartes de cette famille, même avec des cartes d'une autre famille à côté",
  "rule": {
    "kind": "minCardCount",
    "params": { "min": 1, "family": "eternity" }
  },
  "section": 1,
  "placements": [
    {
      "sectionIndex": 1,
      "card": { "family": "instant", "value": 6 },
      "faceUp": false
    },
    {
      "sectionIndex": 1,
      "card": { "family": "eternity", "value": 2 },
      "faceUp": false
    },
    {
      "sectionIndex": 4,
      "card": { "family": "eternity", "value": 8 },
      "faceUp": true
    }
  ],
  "expected": []
}
