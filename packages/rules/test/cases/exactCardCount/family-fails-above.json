{
  "description": "exactCardCount avec une famille échoue quand la famille a une carte de trop",
  "rule": {
    "kind": "exactCardCount",
    "params": { "count": 1, "family": "eternity" }
  },
  "section": 5,
  "placements": [
    {
      "sectionIndex": 5,
      "card": { "family": "eternity", "value": 11 },
      "faceUp": false
    },
    {
      "sectionIndex": 5,
      "card": { "family": "eternity", "value": 12 },
      "faceUp": false
    },
    {
      "sectionIndex": 5,
      "card": { "family": "instant", "value": 1 },
      "faceUp": false
